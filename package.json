{
  "name": "forest-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cf:version": "wrangler --version",
    "cf:login": "wrangler login",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file=seed.sql",
    "typecheck": "tsc --noEmit",
    "test:api": "node scripts/check-api.mjs",
    "test:members": "node scripts/check-members.mjs",
    "build:production": "node scripts/build-production.mjs",
    "deploy": "npm run build:production && wrangler deploy --config dist/forest_flow/wrangler.json",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config deployment/wrangler.jsonc",
    "account:setup": "node scripts/setup-team-account.mjs --remote",
    "account:setup:local": "node scripts/setup-team-account.mjs",
    "test:shared-login": "node scripts/check-shared-login.mjs",
    "test:import-api": "node scripts/check-import-api.mjs",
    "test:import-parser": "node scripts/check-import-parser.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261026.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "7.30.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
