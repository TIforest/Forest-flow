{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "forest-flow",
  "main": "../worker/index.ts",
  "compatibility_date": "2026-10-26",
  "triggers": { "crons": ["* * * * *"] },
  "workers_dev": true,
  "vars": {
    "ENTRA_REDIRECT_URI": "https://forest-flow.forestpaper.workers.dev/api/auth/microsoft/callback",
    "ENTRA_CLIENT_ID": "98042fb3-4213-4b41-88fd-9587d2726d29",
    "ENTRA_TENANT_ID": "0275c0a9-897a-4be2-8fa3-ec49e3be273d",
    "ALLOWED_EMAIL_DOMAIN": "forest.ind.br",
  },
  "assets": {
    "directory": "../dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forest-flow",
      "database_id": "94c43ec6-7cfb-47d8-8ccb-9721ea2d55c5",
      "migrations_dir": "../migrations",
    },
  ],
}
